{
  "schemaVersion": "1.0.0",
  "kind": "executable",
  "name": "Read slow service health",
  "type": "backend",
  "runner": "http",
  "requirementRefs": [],
  "steps": [
    {
      "id": "get-health",
      "kind": "action",
      "operation": "request",
      "description": "Read the controlled health endpoint",
      "required": true,
      "input": {
        "method": "GET",
        "pathSegments": [
          {
            "literal": "slow"
          }
        ],
        "query": [],
        "headers": {}
      },
      "timeoutMs": 300000
    },
    {
      "id": "check-status",
      "kind": "assertion",
      "operation": "assert",
      "description": "Require HTTP 200",
      "required": true,
      "input": {
        "responseStepId": "get-health"
      },
      "expectation": {
        "predicate": "statusIn",
        "values": [
          200
        ]
      },
      "timeoutMs": 30000
    },
    {
      "id": "check-health",
      "kind": "assertion",
      "operation": "assert",
      "description": "Require a healthy service state",
      "required": true,
      "input": {
        "responseStepId": "get-health",
        "jsonPointer": "/status"
      },
      "expectation": {
        "predicate": "jsonEquals",
        "value": {
          "literal": "ok"
        }
      },
      "timeoutMs": 30000
    }
  ],
  "dependsOn": [],
  "cleanup": [],
  "tags": [],
  "priority": "normal"
}
